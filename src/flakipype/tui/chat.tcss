#body {
    height: 1fr;
}

#chat {
    width: 3fr;
}

#conversation {
    height: 1fr;
    padding: 0 1;
}

.entry {
    margin: 1 0 0 0;
    height: auto;
}

.user {
    color: $accent;
    text-style: bold;
}

.note {
    border-left: thick $primary;
    padding: 0 1;
}

.assistant {
    border-left: thick $success;
    padding: 0 1;
}

.error {
    border-left: thick $error;
    color: $error;
    padding: 0 1;
}

#activity {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    text-style: italic;
}

#prompt {
    margin: 0 1;
}

#sidebar {
    width: 1fr;
    min-width: 30;
    border-left: solid $primary;
}

#sidebar-title {
    padding: 0 1;
    text-style: bold;
    color: $accent;
}

#findings {
    height: 1fr;
}

#findings > ListItem {
    padding: 0 1;
}
